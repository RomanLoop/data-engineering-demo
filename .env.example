# Copy to .env and fill in real values. .env is gitignored — never commit real values (AGENT.md §8).

# Fabric / Azure AD. Local dev uses CLI auth (`az login` as yourself, see
# dbt/profiles.yml) — FABRIC_CLIENT_ID/SECRET below are only needed if you
# switch profiles.yml to `authentication: SPN` (e.g. for CI/CD).
FABRIC_TENANT_ID=
FABRIC_WORKSPACE_ID=
FABRIC_LAKEHOUSE_ID=
FABRIC_LAKEHOUSE_NAME=lh_contoso
FABRIC_CLIENT_ID=
FABRIC_CLIENT_SECRET=

# OneLake DFS endpoint is region-specific (see the workspace's own
# properties via the Fabric REST API — oneLakeEndpoints.dfsEndpoint).
# Used by scripts/upload_to_onelake.py.
FABRIC_ONELAKE_DFS_ENDPOINT=

# Azure Storage account used as the Meltano landing target (see plan.md — OneLake needs a
# Fabric Shortcut on top of this, since OneLake itself only supports Azure AD auth, not
# storage account keys, which is what target-azureblobstorage requires).
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=
